# Web to Kindle Screenshot Service Configuration

# Server Configuration
PORT=3003

# Screenshot Configuration
# The URL to capture screenshots from
SCREENSHOT_URL=https://home-ui.vercel.app/

# Viewport dimensions (used for initial page rendering)
VIEWPORT_WIDTH=600
VIEWPORT_HEIGHT=800

# Kindle Resolution (final image dimensions)
KINDLE_WIDTH=1200
KINDLE_HEIGHT=1600

# Puppeteer Configuration
# Path to Chrome/Chromium executable (optional - Heroku buildpack sets this)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
